# AEGIS backend configuration.
# Copy to .env and adjust locally. NEVER commit a real .env file.

# --- Identity ---
SERVICE_NAME=aegis-backend
VERSION=0.1.0
ENVIRONMENT=development

# --- Persistence ---
DATABASE_URL=sqlite:///./aegis.db

# --- Auth ---
# Generate a real value for any non-local deployment.
JWT_SECRET=dev-only-insecure-secret-change-me
TOKEN_TTL_MINUTES=240
APPROVAL_TTL_SECONDS=180

# --- Gemini (planning layer) ---
# Without a key AEGIS falls back to the deterministic planner. It never fails open.
GEMINI_API_KEY=
# Free tier is rate limited per minute (flash ~20 rpm). The -lite models have a
# separate, larger budget, which survives a live demo better.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12

# --- Google OAuth (sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
# The secret stays on the backend and is NEVER sent to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:3000

# Demo password login for seeded accounts. Set false (or ENVIRONMENT=production) to refuse it.
ALLOW_PASSWORD_LOGIN=true

# --- Observability ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- HTTP ---
API_PREFIX=/api

# No secrets are required in Phase 0. When API keys are introduced in a later
# phase, add placeholder names here only - never real values.
